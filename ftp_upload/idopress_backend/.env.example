# 이도출판 디지털 장서각 - 환경 변수 설정
# 실제 배포 시 .env 파일로 복사하여 수정하세요

# Flask 설정
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT 설정
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# 데이터베이스 설정 (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/idopress_db

# 또는 MySQL 사용 시
# DATABASE_URL=mysql://username:password@localhost:3306/idopress_db

# 또는 SQLite 사용 시 (개발/테스트용)
# DATABASE_URL=sqlite:///idopress.db

# CORS 설정 (프론트엔드 도메인)
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# 파일 업로드 설정
UPLOAD_FOLDER=/path/to/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB

# 이메일 설정 (선택사항)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# 로깅 설정
LOG_LEVEL=INFO
LOG_FILE=/path/to/logs/idopress.log